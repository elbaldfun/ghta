# ---- Server (cmd/api) ----
PORT=3000
LOG_LEVEL=info
# Guards GET /internal/jobs. Empty = that route returns 503.
ADMIN_API_TOKEN=

# ---- MongoDB (required by api and worker) ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=github-trend

# ---- Worker (cmd/worker) ----
# Required for the fetch, reconcile and devsync jobs.
GITHUB_API_TOKEN=
HF_TOKEN=
# The nightly pipeline (cron, 6-field robfig format: sec min hour dom mon dow).
PIPELINE_CRON=0 30 3 * * *
RATE_LIMIT_BUFFER=200
# The judge job joins the pipeline only when both are set: any
# OpenAI-compatible model server (see internal/judge).
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=

# ---- cmd/eval and cmd/import only ----
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_LOCAL_MODULE_NAME=
EMBED_MODEL=
EMBED_SIM_THRESHOLD=0.35
